{
  "name": "surf-forecast-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "forecast": "node --env-file-if-exists=.env --import tsx src/cli.ts forecast",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp-server.ts",
    "providers": "node --env-file-if-exists=.env --import tsx src/cli.ts providers",
    "spots": "node --env-file-if-exists=.env --import tsx src/cli.ts spots",
    "probe:providers": "node --env-file-if-exists=.env --import tsx scripts/probe-providers.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
